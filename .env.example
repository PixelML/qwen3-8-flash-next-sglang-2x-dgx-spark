# Copy to .env on the controller and both DGX Spark nodes.
# Do not commit .env or .sglang-api-key.

SPARK_1_HOST=spark-1
SPARK_2_HOST=spark-2
REMOTE_INSTALL_DIR=/opt/qwen38-sglang

# Exact local checkpoint path; use the same path on both nodes.
MODEL_DIR=/srv/models/RadixArk-Qwen3.8-Flash-Next-NVFP4-7b719225

# Direct RoCE topology. Replace these example addresses and devices.
RANK0_ADDR=10.10.120.2
DIST_PORT=20000
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3

API_PORT=8888
CONTEXT_LENGTH=262144
MAX_RUNNING_REQUESTS=36
# NEXTN/MTP state allocation reduced the effective scheduler limit to 25 in
# the verified 262K-context profile.
MEM_FRACTION_STATIC=0.80
